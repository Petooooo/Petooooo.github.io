{
  "name": "@portfolio-platform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "python3 ../../automation/scripts/validate-mdx-inline-code.py && python3 ../../automation/scripts/check-project-titles.py && python3 ../../automation/scripts/check-source-figure-resolution.py",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "precheck": "python3 ../../automation/scripts/validate-mdx-inline-code.py && python3 ../../automation/scripts/check-project-titles.py && python3 ../../automation/scripts/check-source-figure-resolution.py",
    "check": "astro check",
    "lint": "astro check",
    "postbuild": "node scripts/render-ko-editorials.mjs && python3 ../../automation/scripts/localize-static-site.py build && python3 ../../automation/scripts/check-korean-editions.py",
    "l10n:collect": "python3 ../../automation/scripts/localize-static-site.py collect",
    "l10n:translate": "python3 ../../automation/scripts/localize-static-site.py translate"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.13.0",
    "github-slugger": "^2.0.0",
    "reading-time": "^1.5.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.3"
  }
}