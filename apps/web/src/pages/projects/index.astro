---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import PageHeader from "@/components/PageHeader.astro";
import { byDateDesc, isPublishedEntry } from "@/lib/content";
import { withBase } from "@/lib/urls";

const projects = (await getCollection("projects")).filter(isPublishedEntry).sort(byDateDesc);

const rokafOrder = [
  "rokaf-private-artifacts-and-ci",
  "rokaf-stateful-storage-and-recovery",
  "rokaf-database-ha-and-langfuse-migrations",
  "rokaf-clickhouse-replication-migration",
  "rokaf-identity-rbac-and-policy",
  "rokaf-networking-and-tls",
  "rokaf-gpu-scheduling-and-capacity",
  "rokaf-async-workers-and-idempotency"
];
const investigationOrder = [
  "rokaf-langfuse-v4-migration-field-notes",
  "rokaf-dns-vip-open-investigations",
  "rokaf-gpu-discovery-open-investigation",
  "rokaf-control-plane-incident-log"
];
const journal = projects
  .filter((p) => rokafOrder.includes(p.slug))
  .sort((a, b) => rokafOrder.indexOf(a.slug) - rokafOrder.indexOf(b.slug));
const openInvestigations = projects
  .filter((p) => investigationOrder.includes(p.slug))
  .sort((a, b) => investigationOrder.indexOf(a.slug) - investigationOrder.indexOf(b.slug));
const highlights = [
  {
    type: "Undergraduate project / memory efficiency",
    title: "Lifecycle-aware allocation for TensorFlow Lite Micro",
    href: "/projects/tflite-micro-lifecycle-memory-planning/",
    result: "28.33% / 14.06%",
    metric: "Peak-memory reductions on Person Detect / Tiny U-Net",
    description: "Analyzed tensor lifetimes and allocation conflicts, then explored buffer reuse and in-place updates to reduce memory pressure.",
    tags: ["TFLite Micro", "Memory planning", "C / C++"]
  },
  {
    type: "Undergraduate project / hardware acceleration",
    title: "Area-efficient CNN acceleration on Zynq FPGA",
    href: "/projects/bit-shift-cnn-accelerator-zynq/",
    result: "36.5%",
    metric: "FPGA area reduction in project evaluation",
    description: "Used bit-shift arithmetic, quantization, IM2COL, and systolic-array dataflow to explore the area/runtime trade-offs of embedded inference.",
    tags: ["FPGA", "Zynq", "Verilog"]
  },
  {
    type: "ROKAF / Systems engineering",
    title: "Independent on-premises K3s platform engineering",
    href: "/projects/independent-on-premises-k3s-platform-engineering/",
    result: "K3s / Linux",
    metric: "Independently built & operated · Jul 2025–Present",
    description: "After my July 7 assignment, independently built and operated K3s-based infrastructure, handling service deployment, private artifacts, storage, troubleshooting, and recovery.",
    tags: ["Kubernetes", "Longhorn", "Nexus"]
  }
];
---
<BaseLayout title="Projects" description="Selected projects and engineering experience: TinyML memory planning, FPGA acceleration, and Linux infrastructure.">
  <PageHeader eyebrow="Selected work" title="Projects & engineering" description="Memory-efficient ML, FPGA acceleration, and practical systems engineering." />
  <section class="py-12 md:py-16">
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {highlights.map((item) => (
        <article class="flex flex-col border border-white/10 bg-white/[0.025] p-5">
          <p class="font-mono text-xs uppercase tracking-wider text-signal">{item.type}</p>
          <h2 class="mt-4 text-xl font-semibold text-white">
            {item.href ? <a class="underline decoration-white/20 underline-offset-4 hover:text-signal" href={withBase(item.href)}>{item.title}</a> : item.title}
          </h2>
          <p class="mt-5 text-2xl font-semibold tracking-tight text-white">{item.result}</p>
          <p class="mt-1 text-xs leading-5 text-slate-400">{item.metric}</p>
          <p class="mt-5 flex-1 text-sm leading-7 text-slate-300">{item.description}</p>
          <div class="mt-5 flex flex-wrap gap-2 border-t border-white/10 pt-4">
            {item.tags.map((tag) => <span class="border border-white/10 px-2 py-1 font-mono text-xs text-slate-300">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm leading-7 text-slate-400">The two undergraduate projects now have detailed write-ups based on my original 2024 report and team poster. Reported results, individual responsibilities, and unverified aspects are distinguished within each article.</p>
  </section>

  <section class="border-t border-white/10 py-12 md:py-16">
    <SectionHeader eyebrow="ROKAF · Engineering journal" title="Systems engineering records" description="Eight detailed accounts of the engineering choices, failed assumptions and reliability trade-offs behind the platform." />
    <div class="grid gap-4 md:grid-cols-2">
      {journal.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="border-t border-white/10 py-12 md:py-16">
    <SectionHeader eyebrow="Ongoing investigations" title="Field notes & open questions" description="Progress records from real troubleshooting, including issues whose final root cause or full verification remained open." />
    <div class="grid gap-4 md:grid-cols-2">
      {openInvestigations.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>


</BaseLayout>
