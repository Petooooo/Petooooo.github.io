---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AreaPostRail from "@/components/AreaPostRail.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { byDateDesc, getAreaId, getEntryArea, isPublishedEntry, sortAreas } from "@/lib/content";
const entries = (await getCollection("notes")).filter(isPublishedEntry).sort(byDateDesc);
const areaOrder = [
  "Algorithms",
  "Baekjoon",
  "Computer Networks",
  "Operating Systems",
  "Databases",
  "System Software",
  "Digital Circuits",
  "Computer Architecture",
  "Cloud Infrastructure",
  "Programming",
  "Security",
  "Uncategorized"
];
const areaGroups = sortAreas([...new Set(entries.map(getEntryArea))], areaOrder).map((area) => ({
  area,
  entries: entries.filter((entry) => getEntryArea(entry) === area)
}));
---
<BaseLayout title="Notes" description="Technical notes and reusable references.">
  <section class="py-12 md:py-14">
    <SectionHeader eyebrow="Notes" title="Study And Concept Notes" description="A technical study notebook for cloud infrastructure, Kubernetes, networking, databases, operating systems, algorithms, digital logic, security, implementation techniques, and concise concept summaries." />
    {areaGroups.length > 0 && (
      <nav class="mb-8 border-y border-white/10 py-3" aria-label="Notes areas">
        <div class="flex flex-wrap gap-2">
        {areaGroups.map(({ area, entries }) => (
          <a class="border border-white/10 px-2.5 py-1 text-xs text-slate-300 hover:border-signal/50 hover:text-white" href={`#${getAreaId(area)}`}>{area} <span class="font-mono text-slate-500">{entries.length}</span></a>
        ))}
        </div>
      </nav>
    )}
    <div class="grid gap-8">
      {areaGroups.map(({ area, entries }) => <AreaPostRail area={area} entries={entries} label="note" />)}
    </div>
  </section>
</BaseLayout>
