---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AreaPostRail from "@/components/AreaPostRail.astro";
import PageHeader from "@/components/PageHeader.astro";
import { byDateDesc, getAreaId, getEntryArea, isPublishedEntry, sortAreas } from "@/lib/content";
const entries = (await getCollection("notes")).filter(isPublishedEntry).sort(byDateDesc);
const areaOrder = [
  "Study Roadmap",
  "Linux Kernel",
  "System Programming",
  "Algorithms",
  "Baekjoon",
  "Computer Networks",
  "Networking",
  "Operating Systems",
  "Kubernetes",
  "Troubleshooting",
  "CI/CD",
  "Databases",
  "System Software",
  "Digital Circuits",
  "Computer Architecture",
  "Cloud Infrastructure",
  "Registry/Nexus",
  "Storage",
  "Programming",
  "Security",
  "Raspberry Pi / Homelab",
  "Uncategorized"
];
const areaGroups = sortAreas([...new Set(entries.map(getEntryArea))], areaOrder).map((area) => ({
  area,
  entries: entries.filter((entry) => getEntryArea(entry) === area)
}));
---
<BaseLayout title="Notes" description="Technical notes, implementation details, operating records, and reusable references.">
  <PageHeader eyebrow="Notes" title="Technical notebook" description="Study notes, programming exercises, and engineering references." />
  <section class="py-12 md:py-16">
    {areaGroups.length > 0 && (
      <nav class="mb-8 border-y border-white/10 py-3" aria-label="Notes areas">
        <div class="flex flex-wrap gap-2">
        {areaGroups.map(({ area, entries }) => (
          <a class="border border-white/10 px-2.5 py-1 text-xs text-slate-300 hover:border-signal/50 hover:text-white" href={`#${getAreaId(area)}`}>{area} <span class="font-mono text-slate-500">{entries.length}</span></a>
        ))}
        </div>
      </nav>
    )}
    <div class="grid gap-8">
      {areaGroups.map(({ area, entries }) => <AreaPostRail area={area} entries={entries} label="note" />)}
    </div>
  </section>
</BaseLayout>
