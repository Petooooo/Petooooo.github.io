---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCard from "@/components/ContentCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { siteConfig } from "@/site.config";
import { byDateDesc, getCollectionUrl, isPublishedEntry } from "@/lib/content";
import { withBase } from "@/lib/urls";

const projects = (await getCollection("projects")).filter(isPublishedEntry);
const notes = (await getCollection("notes")).filter(isPublishedEntry);
const devops = (await getCollection("devops")).filter(isPublishedEntry);
const research = (await getCollection("research")).filter(isPublishedEntry);
const paperReviews = (await getCollection("paper-reviews")).filter(isPublishedEntry);
const posts = [
  ...notes,
  ...devops,
  ...research,
  ...paperReviews
]
  .filter(isPublishedEntry)
  .sort(byDateDesc);
const recentPosts = posts.slice(0, 4);
const sections = [
  { title: "Notes", description: "Concept notes for systems, cloud infrastructure, networks, databases, operating systems, algorithms, and implementation details.", href: "/notes", count: notes.length },
  { title: "DevOps", description: "Operational records: troubleshooting notes, runbooks, deployment decisions, recovery paths, and infrastructure constraints.", href: "/devops", count: devops.length },
  { title: "Projects", description: "Project-level records around restricted-network platform migration, stateful recovery, artifact workflows, and resource-constrained AI systems.", href: "/projects", count: projects.length },
  { title: "Research", description: "Research-oriented notes around reliable systems, storage recovery, ML systems, AI serving infrastructure, and hardware-aware execution.", href: "/research", count: research.length },
  { title: "Paper Reviews", description: "Technical paper reading notes focused on core ideas, implementation details, limitations, and references.", href: "/paper-reviews", count: paperReviews.length }
];
---

<BaseLayout>
  <section class="border-b border-white/10 py-10 md:py-14">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">Jihwan Park / engineering notebook</p>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold leading-tight text-white md:text-5xl">
        Engineering notes on constrained infrastructure, service recovery, and resource-aware AI systems.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">
        This site collects sanitized engineering notes about restricted-network platform migration, stateful service recovery, private artifact workflows, operational AI serving constraints, and resource-constrained AI projects.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/cv")}>CV</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/notes")}>Notes</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/devops")}>DevOps</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/projects")}>Projects</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={siteConfig.githubUrl}>GitHub</a>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-12">
    <SectionHeader eyebrow="Work Map" title="Concrete Threads" description="The recurring pattern is not a broad interest in infrastructure; it is a set of specific failure modes, constraints, and design decisions that kept showing up across service operation and AI workload projects." />
    <div class="grid gap-4 md:grid-cols-2">
      {[
        ["Restricted-Network Platform Migration", "Selected services moved from ad-hoc Docker operation toward a lightweight Kubernetes/K3S-based platform while dealing with image distribution, service exposure, persistent storage, and deployment standardization."],
        ["Stateful Service Recovery", "PVC-backed services required thinking beyond pod rescheduling: storage detach/attach delay, rebuild behavior, service readiness, downtime, and RTO/RPO boundaries."],
        ["Private Artifact and Bootstrap Supply Chain", "Restricted networks made artifact distribution part of reliability work: image mirroring, Maven/Nexus behavior, bootstrap dependency paths, and registry self-dependency risks."],
        ["Full-GPU Serving Availability", "Full-GPU workloads made fine-grained sharing less straightforward, so degraded serving, active-active replicas, and traffic rerouting became more realistic availability questions."],
        ["TinyML Memory Planning", "TensorFlow Lite Micro work focused on tensor lifetimes, conflict relationships, BFS-style allocation ordering, and in-place update opportunities to reduce peak memory."],
        ["Hardware-Aware CNN Acceleration", "The Zynq FPGA accelerator project used bit-shift operations, INQ/STE quantization, IM2COL, systolic array dataflow, and AXI4-Lite PS/PL integration to study area/runtime tradeoffs."]
      ].map(([title, description]) => (
        <div class="border-b border-white/10 py-4">
          <h2 class="text-base font-semibold text-white">{title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-300">{description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-10 md:py-12">
    <SectionHeader eyebrow="Index" title="Technical Index" description="Concept study notes are separated from operational records so DevOps stays closer to troubleshooting, runbooks, deployment decisions, and recovery paths." />
    <div class="grid gap-3 md:grid-cols-2">
      {sections.map((section) => (
        <a class="grid grid-cols-[1fr_auto] gap-4 border-b border-white/10 py-4 hover:border-signal/60" href={withBase(section.href)}>
          <div>
            <h3 class="text-base font-semibold text-white">{section.title}</h3>
            <p class="mt-1 text-sm leading-6 text-slate-300">{section.description}</p>
          </div>
          <p class="font-mono text-xs text-slate-500">{section.count}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-10 md:py-12">
    <SectionHeader eyebrow="Recent" title="Recent Entries" description="Latest published notes from the public technical sections." />
    <div class="grid gap-4 md:grid-cols-2">
      {recentPosts.map((entry) => <ContentCard entry={entry} href={getCollectionUrl(entry)} label={entry.collection} />)}
    </div>
  </section>
</BaseLayout>
