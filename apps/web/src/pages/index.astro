---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCard from "@/components/ContentCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { siteConfig } from "@/site.config";
import { byDateDesc, getCollectionUrl, isPublishedEntry } from "@/lib/content";
import { withBase } from "@/lib/urls";

const projects = (await getCollection("projects")).filter(isPublishedEntry);
const notes = (await getCollection("notes")).filter(isPublishedEntry);
const devops = (await getCollection("devops")).filter(isPublishedEntry);
const research = (await getCollection("research")).filter(isPublishedEntry);
const paperReviews = (await getCollection("paper-reviews")).filter(isPublishedEntry);
const posts = [
  ...notes,
  ...devops,
  ...research,
  ...paperReviews
]
  .filter(isPublishedEntry)
  .sort(byDateDesc);
const recentPosts = posts.slice(0, 4);
const sections = [
  { title: "Notes", description: "Concept notes for Kubernetes, cloud infrastructure, networks, databases, algorithms, OS, and implementation details.", href: "/notes", count: notes.length },
  { title: "DevOps", description: "Operational records only: runbooks, troubleshooting notes, deployment decisions, and recovery paths.", href: "/devops", count: devops.length },
  { title: "Projects", description: "Project-level records around air-gapped platforms, stateful recovery, supply chains, and resource-constrained AI systems.", href: "/projects", count: projects.length },
  { title: "Research", description: "Research-oriented notes for reliable systems, distributed systems, storage systems, AI infrastructure, and hardware-aware cloud systems.", href: "/research", count: research.length },
  { title: "Paper Reviews", description: "Technical paper reading notes focused on core ideas, implementation details, limitations, and references.", href: "/paper-reviews", count: paperReviews.length }
];
---

<BaseLayout>
  <section class="border-b border-white/10 py-10 md:py-14">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">Jihwan Park / systems-first engineering notebook</p>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold leading-tight text-white md:text-5xl">
        Reliable cloud-native systems for constrained environments.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">
        I write about air-gapped Kubernetes/K3S platforms, stateful workload recovery, internal artifact supply chains, degraded AI serving, and resource-constrained AI systems.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/cv")}>CV</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/notes")}>Notes</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/devops")}>DevOps</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={withBase("/projects")}>Projects</a>
        <a class="border border-white/20 px-3 py-2 text-sm text-white hover:border-signal hover:text-signal" href={siteConfig.githubUrl}>GitHub</a>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-12">
    <SectionHeader eyebrow="Thread" title="Main Technical Axis" description="The notes and project records are organized around one recurring problem: making workloads run reliably when infrastructure, network, storage, GPU, memory, or hardware resources are constrained." />
    <div class="grid gap-4 md:grid-cols-3">
      {[
        ["Air-Gapped Platforms", "K3S, private registry, Nexus, internal CI/CD, GitOps-style operation, service exposure, and reproducible deployment without public cloud assumptions."],
        ["Reliability And Recovery", "Stateful workload recovery, Longhorn PVC behavior, RTO/RPO thinking, bootstrap dependency paths, and practical failure modes."],
        ["Resource-Constrained AI", "TinyML memory planning, FPGA-based CNN acceleration, full-GPU serving tradeoffs, degraded serving, and hardware-aware systems design."]
      ].map(([title, description]) => (
        <div class="border-b border-white/10 py-4">
          <h2 class="text-base font-semibold text-white">{title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-300">{description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-10 md:py-12">
    <SectionHeader eyebrow="Index" title="Technical Index" description="The public sections are organized by the kind of work each entry records." />
    <div class="grid gap-3 md:grid-cols-2">
      {sections.map((section) => (
        <a class="grid grid-cols-[1fr_auto] gap-4 border-b border-white/10 py-4 hover:border-signal/60" href={withBase(section.href)}>
          <div>
            <h3 class="text-base font-semibold text-white">{section.title}</h3>
            <p class="mt-1 text-sm leading-6 text-slate-300">{section.description}</p>
          </div>
          <p class="font-mono text-xs text-slate-500">{section.count}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-10 md:py-12">
    <SectionHeader eyebrow="Recent" title="Recent Entries" description="Latest published notes from the public technical sections." />
    <div class="grid gap-4 md:grid-cols-2">
      {recentPosts.map((entry) => <ContentCard entry={entry} href={getCollectionUrl(entry)} label={entry.collection} />)}
    </div>
  </section>
</BaseLayout>
