---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import OverviewCard from "@/components/OverviewCard.astro";
import ContentCard from "@/components/ContentCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { byDateDesc, getCollectionUrl, isPublishedEntry } from "@/lib/content";
import { withBase } from "@/lib/urls";

const notes = (await getCollection("notes")).filter(isPublishedEntry);
const research = (await getCollection("research")).filter(isPublishedEntry);
const recentPosts = [...notes, ...research].sort(byDateDesc).slice(0, 4);

const interests = [
  {
    label: "Research interest",
    title: "Linux kernel & I/O",
    description: "How file systems, the VFS, page cache, and block layer affect performance and behavior.",
    tags: ["Linux", "VFS", "Block I/O"]
  },
  {
    label: "Research interest",
    title: "Flash storage",
    description: "The interaction between NVMe, zoned flash, garbage collection, and file-system design.",
    tags: ["NVMe", "ZNS", "File systems"]
  },
  {
    label: "Research interest",
    title: "Memory & data movement",
    description: "Memory management and the path between accelerators, host memory, and storage.",
    tags: ["Memory", "GPU–storage I/O", "Performance"]
  }
];

const experience = [
  {
    label: "Project",
    period: "Undergraduate",
    title: "TensorFlow Lite Micro memory planning",
    description: "Analyzed tensor lifetimes and allocation conflicts to reduce peak memory use in constrained inference.",
    href: "/cv/#selected-projects",
    tags: ["C / C++", "TFLite Micro", "Memory allocation"]
  },
  {
    label: "Project",
    period: "Undergraduate",
    title: "CNN acceleration on Zynq FPGA",
    description: "Explored quantized inference and systolic-array dataflow with measured area and runtime trade-offs.",
    href: "/cv/#selected-projects",
    tags: ["Verilog", "FPGA", "Zynq"]
  },
  {
    label: "Kernel training",
    period: "2023–2024",
    title: "Linux System & Kernel Expert Course",
    description: "Studied Linux internals and system programming; practiced tracing kernel execution using ftrace and KernelShark.",
    href: "/cv/#technical-training",
    tags: ["Linux", "ftrace", "KernelShark"]
  },
  {
    label: "Systems engineering",
    period: "2025–2026",
    title: "Linux infrastructure & recovery",
    description: "Worked with K3s, private image distribution, persistent storage, and recovery of stateful services.",
    href: "/cv/#infrastructure-experience",
    tags: ["K3s", "Longhorn", "Nexus"]
  }
];

const skillGroups = [
  { title: "Languages", items: ["C", "C++", "Python", "Shell", "TypeScript", "SQL"] },
  { title: "Systems", items: ["Linux", "Git", "Docker", "Kubernetes / K3s", "Longhorn"] },
  { title: "Data & infrastructure", items: ["ClickHouse", "MinIO", "MongoDB", "Nexus"] },
  { title: "Hardware & embedded", items: ["Verilog", "FPGA", "Zynq", "TFLite Micro"] }
];
---

<BaseLayout description="Jihwan Park — incoming KAIST M.S. in AI Systems, joining the Operating Systems Laboratory in Spring 2027. Linux, file systems, storage and memory.">
  <section class="border-b border-white/10 py-16 md:py-20">
    <div class="max-w-4xl">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-signal">
        KAIST · Incoming M.S. · Spring 2027
      </p>
      <h1 class="mt-5 text-5xl font-semibold leading-[1.1] tracking-[-0.035em] text-white sm:text-6xl md:text-7xl">
        Jihwan Park<span class="text-signal">.</span>
      </h1>
      <p class="mt-5 text-xl leading-8 text-slate-200 md:text-2xl">
        Department of AI Systems <span class="text-slate-500">/</span> Operating Systems Laboratory
      </p>
      <p class="mt-6 max-w-3xl text-base leading-8 text-slate-300">
        Interested in Linux, file systems, storage, and memory systems.
        My experience so far spans kernel training, embedded ML, FPGA acceleration, and operating Linux infrastructure.
      </p>
      <div class="mt-9 border-t border-white/10 pt-5">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-slate-500">Background</p>
        <p class="mt-2 text-sm leading-7 text-slate-400">
          B.S. Computer Science &amp; Engineering · Electronic Engineering (double major)<br />
          Kyung Hee University
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <SectionHeader eyebrow="Direction" title="Research interests" description="Topics I'm preparing to explore during graduate study." />
    <div class="grid gap-4 md:grid-cols-3">
      {interests.map((item) => <OverviewCard {...item} />)}
    </div>
  </section>

  <section class="border-t border-white/10 py-12 md:py-16">
    <SectionHeader eyebrow="Background" title="Projects &amp; experience" description="Undergraduate work, kernel training, and systems operations." />
    <div class="grid gap-4 md:grid-cols-2">
      {experience.map((item) => <OverviewCard {...item} href={withBase(item.href)} />)}
    </div>
  </section>

  <section class="border-t border-white/10 py-12 md:py-16">
    <SectionHeader eyebrow="Toolkit" title="Technologies" description="Tools I've used in projects, training, and infrastructure work." />
    <div class="grid gap-4 md:grid-cols-2">
      {skillGroups.map((group) => (
        <div class="flex min-w-0 flex-col rounded-md border border-white/10 bg-white/[0.025] p-5">
          <p class="font-mono text-xs uppercase tracking-[0.12em] text-slate-400">Toolkit</p>
          <h3 class="mt-4 text-lg font-semibold text-white">{group.title}</h3>
          <div class="mt-6 flex flex-wrap gap-2 border-t border-white/10 pt-4">
            {group.items.map((tech) => <span class="rounded-sm border border-white/10 px-2 py-1 text-xs text-slate-300">{tech}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="border-t border-white/10 py-12 md:py-16">
      <SectionHeader eyebrow="Notebook" title="Recent notes" description="Technical writing, organized by publication date." />
      <div class="grid gap-4 md:grid-cols-2">
        {recentPosts.map((entry) => <ContentCard entry={entry} href={getCollectionUrl(entry)} label={entry.collection === "research" ? "Research" : "Note"} />)}
      </div>
    </section>
  )}
</BaseLayout>
