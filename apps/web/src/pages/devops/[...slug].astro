---
import LegacyRedirect from "@/components/LegacyRedirect.astro";

export function getStaticPaths() {
  const legacySlugs = [
    "k3s-registry-bootstrap-nexus-self-dependency",
    "k3s-kubeconfig-kubectl-k9s",
    "k3s-metallb-servicelbklipper-hostport",
    "k3s-traefik-nodeport-metallb-vip",
    "nexus3-https-registry-root-ca-ip-san-docker"
  ];

  return legacySlugs.map((slug) => ({
    params: { slug },
    props: { destination: `/notes/${slug}/` }
  }));
}

const { destination } = Astro.props;
---
<LegacyRedirect to={destination} />
