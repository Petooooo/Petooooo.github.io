---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AreaPostRail from "@/components/AreaPostRail.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { byDateDesc, getAreaId, getEntryArea, isPublishedEntry, sortAreas } from "@/lib/content";
const entries = (await getCollection("devops")).filter(isPublishedEntry).sort(byDateDesc);
const areaOrder = [
  "Kubernetes",
  "Docker",
  "CI/CD",
  "Git/GitHub",
  "Registry/Nexus",
  "Networking/DNS/TLS",
  "Observability",
  "Raspberry Pi / Homelab",
  "Storage",
  "Troubleshooting",
  "Uncategorized"
];
const areaGroups = sortAreas([...new Set(entries.map(getEntryArea))], areaOrder).map((area) => ({
  area,
  entries: entries.filter((entry) => getEntryArea(entry) === area)
}));
---
<BaseLayout title="DevOps Logs" description="Infrastructure operation notes.">
  <section class="py-12 md:py-14">
    <SectionHeader eyebrow="DevOps" title="Operations And Troubleshooting" description="Runbooks and recovery notes for Kubernetes issues, CoreDNS/Nexus problems, CI/CD, Docker, networking, RP4 deployment, bootstrap dependencies, monitoring, GitOps, and deployment strategy." />
    {areaGroups.length > 0 && (
      <nav class="mb-8 border-y border-white/10 py-3" aria-label="DevOps areas">
        <div class="flex flex-wrap gap-2">
        {areaGroups.map(({ area, entries }) => (
          <a class="border border-white/10 px-2.5 py-1 text-xs text-slate-300 hover:border-signal/50 hover:text-white" href={`#${getAreaId(area)}`}>{area} <span class="font-mono text-slate-500">{entries.length}</span></a>
        ))}
        </div>
      </nav>
    )}
    <div class="grid gap-8">
      {areaGroups.map(({ area, entries }) => <AreaPostRail area={area} entries={entries} label="devops" />)}
    </div>
  </section>
</BaseLayout>
