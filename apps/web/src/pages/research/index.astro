---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCard from "@/components/ContentCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { byDateDesc, getCollectionUrl, isPublishedEntry } from "@/lib/content";
const entries = (await getCollection("research")).filter(isPublishedEntry).sort(byDateDesc);
---
<BaseLayout title="Research" description="Computer science and electrical/electronic engineering research notes.">
  <section class="py-12 md:py-14">
    <SectionHeader eyebrow="Research" title="Engineering Research Notes" description="Research-oriented notes for systems, AI infrastructure, distributed systems, networking, architecture, embedded systems, performance analysis, algorithms, and software engineering." />
    <div class="grid gap-4 md:grid-cols-2">{entries.map((entry) => <ContentCard entry={entry} href={getCollectionUrl(entry)} label="research" />)}</div>
  </section>
</BaseLayout>
