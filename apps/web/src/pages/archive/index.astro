---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCard from "@/components/ContentCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { byDateDesc, getCollectionUrl, isPublishedEntry } from "@/lib/content";

const entries = (await getCollection("archive")).filter(isPublishedEntry).sort(byDateDesc);
---

<BaseLayout title="Archive" description="Temporary notes, experiments, migrated material, and older archive entries.">
  <PageHeader eyebrow="Archive" title="Archive entries" description="Older notes, experiments, and material outside the main sections." />
  <section class="py-12 md:py-16">
    <div class="grid gap-4 md:grid-cols-2">{entries.map((entry) => <ContentCard entry={entry} href={getCollectionUrl(entry)} label="archive" />)}</div>
  </section>
</BaseLayout>

