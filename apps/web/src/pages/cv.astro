---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CVEntry from "@/components/CVEntry.astro";
import PageHeader from "@/components/PageHeader.astro";

const education = [
  {
    period: "Spring 2027 · Incoming",
    title: "Korea Advanced Institute of Science and Technology (KAIST)",
    subtitle: "M.S. in AI Systems · Operating Systems Laboratory",
    detail: "Admission confirmed; studies begin in Spring 2027.",
    emphasis: true
  },
  {
    period: "2021–2025",
    title: "Kyung Hee University",
    subtitle: "B.S. in Computer Science and Engineering · Double major in Electronic Engineering",
    detail: "GPA 4.01 / 4.3 · Top 5% graduate · Academic Excellence Award"
  }
];

const training = [
  {
    period: "Oct 2023–Mar 2024",
    title: "Linux System & Kernel Expert Course",
    subtitle: "K-Digital Training · 2nd cohort",
    detail: "C/POSIX system programming, processes/threads and IPC, scheduling, virtual memory, VFS/file systems, device drivers, and tracing/dump analysis with tools such as ftrace and crash."
  }
];

const infrastructure = [
  {
    period: "Jul 2025–Present",
    title: "ROKAF · On-Premises K3s Platform",
    subtitle: "AI Systems Infrastructure · Independent platform engineering",
    detail: "Received an award from the ROKAF Chief of Staff in recognition of this work.",
    highlights: [
      "Independently established, operated, and troubleshot a K3s-based platform in an on-premises, closed-network environment following my unit assignment.",
      "Handled platform deployments and day-to-day operations across container delivery, persistent storage, internal service networking, and recovery.",
      "Maintained systems under restricted external connectivity, taking responsibility for diagnosing failures and restoring service without relying on public cloud infrastructure."
    ]
  },
  {
    period: "Jul 2025–Present",
    title: "Restricted-Network Platform Migration",
    highlights: [
      "Migrated selected services from ad-hoc Docker operation toward a lightweight Kubernetes/K3s platform in a restricted network.",
      "Worked through deployment standardization, private image distribution, service exposure, persistent storage, and operational recovery.",
      "Designed around limited access to external registries, package repositories, public DNS, and managed cloud services."
    ]
  },
  {
    period: "Jul 2025–Present",
    title: "Stateful Service Recovery Analysis",
    highlights: [
      "Analyzed the difference between zero-downtime failover and fault-tolerant recovery for persistent workloads.",
      "Studied Longhorn-backed PVC detach/attach behavior, recovery time, downtime, and RTO/RPO trade-offs.",
      "Distinguished stateless rescheduling from storage-aware recovery planning."
    ]
  },
  {
    period: "Jul 2025–Present",
    title: "Private Artifact and Bootstrap Supply Chain",
    highlights: [
      "Worked with Nexus, private container registries, image mirroring, and artifact distribution.",
      "Investigated bootstrap dependencies that can prevent a failed artifact service from recovering.",
      "Examined how Maven/Nexus artifact paths relate to POM GAV metadata."
    ]
  },
  {
    period: "Jul 2025–Present",
    title: "Internal Delivery and Operational Automation",
    highlights: [
      "Evaluated CI/CD and GitOps delivery flows from image builds and registry pushes to deployment synchronization and rollback.",
      "Used Git history and declarative configuration to reason about reproducibility, traceability, and recovery.",
      "Connected service routing, storage, artifact repositories, and automation into a coherent operating model."
    ]
  },
  {
    period: "Jul 2025–Present",
    title: "Full-GPU Serving Availability Strategy",
    highlights: [
      "Evaluated AI serving workloads where full-GPU allocation was more practical than fine-grained sharing.",
      "Considered degraded-capacity serving as a realistic failure-mode strategy.",
      "Compared placement, active-active replicas, MIG, time-slicing, and load-balancer rerouting."
    ]
  }
];

const selectedProjects = [
  {
    period: "Undergraduate project",
    title: "Lifecycle-Aware Memory Analysis for TensorFlow Lite Micro",
    detail: "Analyzed tensor lifetimes, conflict relationships, BFS-style allocation ordering, and in-place update opportunities. Project evaluation reduced peak memory by 28.33% on Person Detect and 14.06% on Tiny U-Net against the original size-based allocation plan."
  },
  {
    period: "Undergraduate project",
    title: "Area-Efficient CNN Accelerator Using Bit-Shift Operations on Zynq FPGA",
    detail: "Explored INQ/STE-based quantization, bit-shift operations, IM2COL, systolic-array dataflow, and AXI4-Lite PS/PL integration. Project evaluation reported a 36.5% FPGA area decrease and 8.83 ms PS+PL runtime versus 15.9 ms PS-only."
  }
];

const researchInterests = [
  ["Linux kernel & I/O", "VFS, file-system internals, page cache, block I/O paths, and performance tracing."],
  ["Flash storage", "Flash / NVMe / ZNS, garbage collection, write ordering, and storage-layer bottlenecks."],
  ["Memory & data movement", "Memory management, GPU–storage I/O, and hardware/software performance trade-offs."],
  ["Systems engineering", "Persistent storage, reliable Linux infrastructure, and stateful service recovery."]
];

const skills = [
  ["Programming", ["C", "C++", "Python", "Shell", "TypeScript", "SQL", "Verilog"]],
  ["Linux & systems", ["Linux", "Git", "Docker", "Kubernetes / K3s", "Longhorn", "Traefik", "CI/CD"]],
  ["Data & infrastructure", ["ClickHouse", "MinIO", "MongoDB", "Nexus", "RabbitMQ"]],
  ["Hardware & embedded", ["FPGA", "Zynq", "Vivado", "Quartus", "STM32", "Arduino", "Raspberry Pi"]]
];
---

<BaseLayout title="CV" description="Jihwan Park — incoming M.S. student in AI Systems at KAIST (Spring 2027), with experience in Linux systems, memory efficiency, FPGA acceleration, and storage infrastructure.">
  <PageHeader
    eyebrow="Curriculum vitae"
    title="Jihwan Park"
    description="Incoming M.S. student in AI Systems at KAIST (Spring 2027), joining the Operating Systems Laboratory."
  >
    <div class="mt-5 flex flex-wrap gap-x-7 gap-y-2 text-sm text-slate-400">
      <a class="underline decoration-white/20 underline-offset-4 hover:text-signal" href="mailto:jihwan.park@kaist.ac.kr">jihwan.park@kaist.ac.kr</a>
      <a class="underline decoration-white/20 underline-offset-4 hover:text-signal" href="https://github.com/Petooooo">GitHub</a>
    </div>
  </PageHeader>

  <section class="py-10 md:py-14">
    <SectionHeader eyebrow="Background" title="Education" />
    <div>
      {education.map((entry) => <CVEntry {...entry} />)}
    </div>
  </section>

  <section class="border-t border-white/10 py-10 md:py-14">
    <SectionHeader eyebrow="Direction" title="Research interests" description="Areas of interest for graduate study." />
    <div class="grid gap-x-10 md:grid-cols-2">
      {researchInterests.map(([title, description]) => (
        <div class="border-t border-white/10 py-5">
          <h3 class="text-base font-semibold text-white">{title}</h3>
          <p class="mt-2 text-sm leading-7 text-slate-400">{description}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="technical-training" class="scroll-mt-24 border-t border-white/10 py-10 md:py-14">
    <SectionHeader eyebrow="Foundation" title="Technical training" />
    <div>
      {training.map((entry) => <CVEntry {...entry} />)}
    </div>
  </section>

  <section id="infrastructure-experience" class="scroll-mt-24 border-t border-white/10 py-10 md:py-14">
    <SectionHeader eyebrow="Experience" title="ROKAF · AI Systems Infrastructure" description="Independently built, operated, and troubleshot on-premises K3s infrastructure in a closed network. Internal system details are omitted." />
    <div>
      {infrastructure.map((entry) => <CVEntry {...entry} />)}
    </div>
  </section>

  <section id="selected-projects" class="scroll-mt-24 border-t border-white/10 py-10 md:py-14">
    <SectionHeader eyebrow="Projects" title="Selected projects" />
    <div>
      {selectedProjects.map((entry) => <CVEntry {...entry} />)}
    </div>
  </section>

  <section class="border-t border-white/10 py-10 md:py-14">
    <SectionHeader eyebrow="Toolkit" title="Technical skills" />
    <div class="grid gap-x-10 md:grid-cols-2">
      {skills.map(([group, values]) => (
        <div class="border-t border-white/10 py-5">
          <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-slate-400">{group}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {(values as string[]).map((tech) => <span class="rounded-sm border border-white/10 px-2.5 py-1 text-xs text-slate-300">{tech}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
