---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
---
<BaseLayout title="About" description="About Jihwan Park and this engineering notebook.">
  <section class="grid gap-10 border-b border-white/10 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:py-16">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">About</p>
      <h1 class="mt-4 text-4xl font-semibold text-white md:text-5xl">Jihwan Park</h1>
      <p class="mt-5 text-base leading-8 text-slate-300 md:text-lg">This site is a public engineering notebook for implementation records, study notes, infrastructure decisions, troubleshooting logs, and research-oriented technical writing.</p>
      <div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-300">
        <a class="rounded border border-white/15 px-3 py-2 hover:border-signal hover:text-signal" href="https://github.com/Petooooo">GitHub</a>
      </div>
    </div>
    <div class="grid gap-5">
      <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
        <h2 class="text-xl font-semibold text-white">Technical Interests</h2>
        <p class="mt-3 leading-7 text-slate-300">Software engineering, systems engineering, AI infrastructure, algorithms, distributed systems, networking, computer architecture, and embedded/system-level engineering.</p>
      </div>
      <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
        <h2 class="text-xl font-semibold text-white">Infrastructure Work</h2>
        <p class="mt-3 leading-7 text-slate-300">Static-first web systems, Linux operations, Raspberry Pi hosting, Docker/Caddy deployment, Git-based publishing, and maintenance routines that can be revisited months later.</p>
      </div>
      <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
        <h2 class="text-xl font-semibold text-white">Writing Boundaries</h2>
        <p class="mt-3 leading-7 text-slate-300">Public notes avoid private infrastructure details, credentials, internal hostnames, and inflated claims. The writing is meant to stay concrete enough to be useful later.</p>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <SectionHeader eyebrow="Focus" title="Working Areas" description="The site is organized around practical records rather than a resume-style narrative." />
    <div class="grid gap-5 md:grid-cols-3">
      {[
        ["Web / Content", "Astro, TypeScript, Tailwind CSS, MDX collections, Decap CMS, RSS, sitemap, and GitHub Pages."],
        ["Infrastructure", "Docker Compose, Caddy, Linux deployment scripts, optional RP4 deployment notes, backup planning, and rollback documentation."],
        ["Study / Research", "Computer science notes, paper reviews, engineering research templates, reproducibility checklists, and implementation observations."]
      ].map(([title, body]) => (
        <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
          <h3 class="text-lg font-semibold text-white">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-300">{body}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
