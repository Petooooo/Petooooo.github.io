---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { withBase } from "@/lib/urls";

const directions = [
  {
    title: "Operating systems & I/O",
    detail: "I want to understand the path between application requests, VFS, filesystem operations and the block layer — and how to measure the bottlenecks."
  },
  {
    title: "Storage & persistence",
    detail: "Flash-aware design, write ordering, data movement, recovery behavior and the software mechanisms that make persistent data dependable."
  },
  {
    title: "Memory & hardware-aware systems",
    detail: "From tiny-device buffer allocation to FPGA accelerators, I enjoy reasoning about what computation costs in memory, bandwidth and resources."
  }
];
---
<BaseLayout title="About" description="Jihwan Park — incoming KAIST master's student interested in operating systems, file systems, storage and memory systems.">
  <PageHeader eyebrow="Background & direction" title="About" description="I'm interested in the systems software behind reliable storage, efficient memory use, and predictable I/O." />

  <section class="py-12 md:py-16">
    <div class="max-w-3xl space-y-5 text-base leading-8 text-slate-300">
      <p>I studied computer science and electronic engineering at Kyung Hee University. I started with Verilog VGA logic and a FreeRTOS desktop built across three STM32 boards, then implemented a five-stage RISC CPU and a systolic-array accelerator. Later, TinyML memory planning and a Zynq CNN accelerator brought software–hardware resource trade-offs into focus.</p>
      <p>Later, I independently built and operated a closed-network K3s platform during my service in the Republic of Korea Air Force. I brought GPU resources under central management with KAI Scheduler and deployed JupyterHub for shared interactive computing, while also handling storage, networking and recovery across the platform. Operating real stateful systems made the distinction between restoring service and understanding a failure mechanism concrete.</p>
      <p>I'm joining KAIST's AI Systems master's program and the Operating Systems Laboratory in spring 2027. I want to go deeper into the layers underneath the infrastructure I've used: Linux, file systems, storage, memory management, and I/O behavior.</p>
    </div>
  </section>

  <section class="border-t border-white/10 py-12 md:py-16">
    <SectionHeader eyebrow="Looking ahead" title="Research interests" description="Questions I want to investigate, not a list of research results already completed." />
    <div class="grid gap-6 md:grid-cols-3">
      {directions.map((item) => (
        <div class="border-t border-white/20 pt-5">
          <h2 class="text-lg font-semibold text-white">{item.title}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">{item.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-white/10 py-10 md:py-12">
    <p class="max-w-3xl text-sm leading-7 text-slate-400">For dates, responsibilities and awards, see my <a class="text-signal underline underline-offset-4" href={withBase("/cv/")}>CV</a>. For the engineering decisions and work behind them, see <a class="text-signal underline underline-offset-4" href={withBase("/projects/")}>Projects</a>. I keep my ongoing study notes in the <a class="text-signal underline underline-offset-4" href={withBase("/notes/")}>technical notebook</a>.</p>
  </section>
</BaseLayout>
