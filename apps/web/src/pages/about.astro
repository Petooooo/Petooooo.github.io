---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { withBase } from "@/lib/urls";
---
<BaseLayout title="About" description="About Jihwan Park and his engineering notebook.">
  <section class="grid gap-10 border-b border-white/10 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:py-16">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">About</p>
      <h1 class="mt-4 text-4xl font-semibold text-white md:text-5xl">Jihwan Park</h1>
      <p class="mt-5 text-base leading-8 text-slate-300 md:text-lg">I am a systems engineer interested in reliable infrastructure for constrained environments. My work connects restricted-network platform migration, stateful service recovery, private artifact workflows, operational AI serving, and resource-constrained AI systems.</p>
      <div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-300">
        <a class="rounded border border-white/15 px-3 py-2 hover:border-signal hover:text-signal" href="https://github.com/Petooooo">GitHub</a>
        <a class="rounded border border-white/15 px-3 py-2 hover:border-signal hover:text-signal" href={withBase("/cv")}>CV</a>
      </div>
    </div>
    <div class="grid gap-5">
      <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
        <h2 class="text-xl font-semibold text-white">Core Direction</h2>
        <p class="mt-3 leading-7 text-slate-300">Reliable systems and platform engineering for services that must operate under network, storage, hardware, and deployment constraints.</p>
      </div>
      <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
        <h2 class="text-xl font-semibold text-white">Systems Background</h2>
        <p class="mt-3 leading-7 text-slate-300">Computer science and electronic engineering background, with work spanning TinyML memory planning, FPGA-based CNN acceleration, Linux, Docker, K3S, Longhorn, registry/Nexus, and GitOps-style workflows.</p>
      </div>
      <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
        <h2 class="text-xl font-semibold text-white">Public Writing Boundary</h2>
        <p class="mt-3 leading-7 text-slate-300">This site keeps sensitive infrastructure details out of public pages. Notes focus on generalized constraints, architecture choices, recovery paths, tradeoffs, and study material that can be reviewed through Git.</p>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <SectionHeader eyebrow="Focus" title="What Connects The Work" description="The common thread is practical systems work under constraints: restricted networks, storage recovery, GPU allocation, memory limits, hardware area, and deployment reliability." />
    <div class="grid gap-5 md:grid-cols-3">
      {[
        ["Restricted-Network Infrastructure", "Moving selected Docker-based service operation toward lightweight Kubernetes/K3S platforms with internal image distribution, service exposure, persistent storage, and deployment standardization."],
        ["Stateful Recovery", "Understanding the difference between stateless rescheduling and storage-aware recovery for PVC-backed workloads, including detach/attach delay and RTO/RPO tradeoffs."],
        ["Resource-Constrained AI Systems", "Looking at AI workloads through memory, dataflow, FPGA area, quantization, GPU allocation, and degraded serving rather than only model architecture."]
      ].map(([title, body]) => (
        <div class="rounded-md border border-white/10 bg-white/[0.03] p-5">
          <h3 class="text-lg font-semibold text-white">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-300">{body}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
