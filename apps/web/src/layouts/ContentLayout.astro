---
import BaseLayout from "./BaseLayout.astro";
import AreaPostIndex from "@/components/AreaPostIndex.astro";
import { byDateAsc, formatDate, getEntryArea, getPublishedCollectionEntries, normalizeTags } from "@/lib/content";
import { withBase } from "@/lib/urls";

const { entry } = Astro.props;
const { Content } = await entry.render();
const parentHref = withBase(`/${entry.collection}`);
const tags = normalizeTags(entry.data.tags as string[]);
const showSource = entry.data.source && entry.data.sensitivity !== "private-source";
const writingType = entry.data.type ?? entry.data.contentType;
const areaEntries = entry.data.area
  ? (await getPublishedCollectionEntries(entry.collection))
      .filter((candidate) => getEntryArea(candidate) === getEntryArea(entry))
      .sort(byDateAsc)
  : [];
const collectionLabels: Record<string, string> = {
  projects: "Projects",
  notes: "Notes",
  devops: "DevOps",
  research: "Research",
  "paper-reviews": "Paper Reviews",
  archive: "Archive"
};
const collectionLabel = collectionLabels[entry.collection] ?? entry.collection;
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.thumbnail} type="article">
  <article class="mx-auto max-w-4xl py-12 md:py-16">
    <a href={parentHref} class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500 hover:text-white">Back to {collectionLabel}</a>
    <header class="mt-8 border-b border-white/10 pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">{collectionLabel}</p>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold leading-tight text-white md:text-5xl">{entry.data.title}</h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-slate-300 md:text-lg">{entry.data.description}</p>
      <dl class="mt-7 grid gap-3 text-sm text-slate-300 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Published</dt>
          <dd class="mt-1"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></dd>
        </div>
        {entry.data.updated && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Updated</dt>
            <dd class="mt-1"><time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time></dd>
          </div>
        )}
        {entry.data.area && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Area</dt>
            <dd class="mt-1">{entry.data.area}</dd>
          </div>
        )}
        {writingType && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Type</dt>
            <dd class="mt-1">{writingType}</dd>
          </div>
        )}
        {entry.data.series && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Series</dt>
            <dd class="mt-1">{entry.data.series}</dd>
          </div>
        )}
        {entry.data.problemId && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Problem</dt>
            <dd class="mt-1">{entry.data.problemId}</dd>
          </div>
        )}
        {entry.data.category && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Category</dt>
            <dd class="mt-1">{entry.data.category}</dd>
          </div>
        )}
        {showSource && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Source</dt>
            <dd class="mt-1">
              {entry.data.sourceUrl ? <a class="text-signal hover:text-white" href={entry.data.sourceUrl}>{entry.data.source}</a> : entry.data.source}
            </dd>
          </div>
        )}
      </dl>
      {tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => <span class="border border-white/10 px-2.5 py-1 text-xs text-slate-300">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="mx-auto mt-10 max-w-3xl">
      <AreaPostIndex currentEntry={entry} entries={areaEntries} placement="mobile" />
      <AreaPostIndex currentEntry={entry} entries={areaEntries} placement="desktop" />
      <div class="prose-platform">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
