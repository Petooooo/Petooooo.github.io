---
interface Props {
  label: string;
  title: string;
  description: string;
  tags?: string[];
  period?: string;
  href?: string;
}

const { label, title, description, tags = [], period, href } = Astro.props;
const Element = href ? "a" : "article";
---
<Element
  href={href}
  class:list={[
    "flex h-full min-w-0 flex-col rounded-md border border-white/10 bg-white/[0.025] p-5",
    href && "group transition-colors hover:border-signal/50 hover:bg-white/[0.045]"
  ]}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <span class="font-mono text-xs uppercase tracking-[0.12em] text-slate-400">{label}</span>
    {period && <span class="font-mono text-xs tabular-nums text-slate-500">{period}</span>}
  </div>
  <h3 class:list={["mt-4 text-lg font-semibold leading-snug text-white", href && "group-hover:text-signal"]}>{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-slate-300">{description}</p>
  {tags.length > 0 && (
    <div class="mt-6 flex flex-wrap gap-2 border-t border-white/10 pt-4">
      {tags.map((tag) => <span class="rounded-sm border border-white/10 px-2 py-1 text-xs text-slate-300">{tag}</span>)}
    </div>
  )}
</Element>
