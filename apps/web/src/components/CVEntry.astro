---
import { withBase } from "@/lib/urls";
import { formatDisplayPeriod } from "@/lib/content";

interface Props {
  href?: string;
  period: string;
  title: string;
  subtitle?: string;
  detail?: string;
  highlights?: string[];
  emphasis?: boolean;
}

const { period, title, subtitle, detail, highlights = [], emphasis = false, href } = Astro.props;
---
<div class="grid gap-2 border-t border-white/10 py-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8 md:py-7">
  <div class="pt-1">
    <span data-list-period class:list={[
      "font-mono text-xs leading-6 uppercase tracking-[0.04em]",
      emphasis ? "text-signal" : "text-slate-500"
    ]}>{formatDisplayPeriod(period)}</span>
  </div>
  <div class="min-w-0">
    <h3 class="text-lg font-semibold leading-7 text-white md:text-xl">
      {href ? <a class="underline decoration-white/20 underline-offset-4 hover:text-signal" href={withBase(href)}>{title}</a> : title}
    </h3>
    {subtitle && <p class="mt-2 text-sm leading-7 text-slate-300">{subtitle}</p>}
    {detail && <p class="mt-2 text-sm leading-7 text-slate-400">{detail}</p>}
    {highlights.length > 0 && (
      <ul class="mt-3 space-y-2 pl-4 text-sm leading-7 text-slate-300 marker:text-slate-500" style="list-style-type: disc;">
        {highlights.map((item) => <li>{item}</li>)}
      </ul>
    )}
  </div>
</div>
