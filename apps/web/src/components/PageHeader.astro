---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-white/10 pb-10 pt-14 md:pb-12 md:pt-16">
  <div class="max-w-4xl">
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-signal">{eyebrow}</p>
    <h1 class="mt-4 text-4xl font-semibold leading-tight tracking-tight text-white md:text-5xl">{title}</h1>
    {description && <p class="mt-5 max-w-3xl text-base leading-8 text-slate-300 md:text-lg">{description}</p>}
    <slot />
  </div>
</section>
