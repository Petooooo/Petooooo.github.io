---
import { formatDisplayPeriod, formatMonth } from "@/lib/content";

const { entry, href, label = "Note" } = Astro.props;
const badges = [...new Set([entry.data.area, ...(entry.data.tags as string[] ?? [])].filter(Boolean))].slice(0, 4);
---

<a href={href} class="group flex h-full min-w-0 flex-col rounded-md border border-white/10 bg-white/[0.025] p-5 transition-colors hover:border-signal/50 hover:bg-white/[0.045]">
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <span class="font-mono text-xs uppercase tracking-[0.12em] text-slate-400">{label}</span>
    {entry.collection === "projects" ? (
      <span data-list-period class="font-mono text-xs uppercase tracking-[0.12em] text-slate-500">{formatDisplayPeriod(entry.data.period)}</span>
    ) : (
      <time data-list-period class="font-mono text-xs uppercase tracking-[0.12em] text-slate-500" datetime={entry.data.date.toISOString().slice(0, 7)}>{formatMonth(entry.data.date)}</time>
    )}
  </div>
  <h3 class="mt-4 text-lg font-semibold leading-snug text-white group-hover:text-signal">{entry.data.title}</h3>
  <p class="mt-3 line-clamp-3 flex-1 text-sm leading-7 text-slate-300">{entry.data.description}</p>
  {badges.length > 0 && (
    <div class="mt-6 flex flex-wrap gap-2 border-t border-white/10 pt-4">
      {badges.map((tag) => <span class="rounded-sm border border-white/10 px-2 py-1 text-xs text-slate-300">{tag}</span>)}
    </div>
  )}
</a>
